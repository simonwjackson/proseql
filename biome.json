{
	"$schema": "https://biomejs.dev/schemas/2.3.14/schema.json",
	"root": true,
	"files": {
		"includes": [
			"packages/*/src/**/*.ts",
			"packages/*/tests/**/*.ts",
			"packages/*/scripts/**/*.{js,mjs,ts}",
			"bench/**/*.ts",
			"scripts/**/*.{js,mjs,ts}",
			"examples/**/*.ts",
			"package.json",
			"packages/*/package.json",
			"tsconfig.json",
			"tsconfig.base.json",
			"packages/*/tsconfig.json",
			"biome.json",
			"!**/dist",
			"!!node_modules"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"suspicious": {
				"noExplicitAny": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"packages/effect/src/database.ts",
				"packages/engine/src/browser.ts",
				"packages/engine/src/database.ts",
				"packages/engine/src/materialized-projection.ts",
				"packages/engine/src/schema-compiler.ts",
				"packages/engine/src/storage-host-shared.ts",
				"packages/engine/src/storage-host.ts",
				"packages/engine/src/types.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "off"
					},
					"suspicious": {
						"noExplicitAny": "off"
					}
				}
			}
		}
	],
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2
	}
}
