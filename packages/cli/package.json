{
  "name": "@proseql/cli",
  "version": "0.13.0",
  "description": "Command-line interface for ProseQL databases. Query, create, update, and manage plain text database files from the terminal.",
  "type": "module",
  "scripts": {
    "build": "bunx tsc --build && chmod +x dist/main.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "bun run build && bun test"
  },
  "bin": {
    "proseql": "dist/main.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "author": "Simon W. Jackson",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonwjackson/proseql.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "database",
    "typescript",
    "effect",
    "cli",
    "command-line",
    "plain-text",
    "yaml",
    "json",
    "toml"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "dependencies": {
    "@proseql/core": "workspace:*",
    "@proseql/node": "workspace:*"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.60"
  }
}
