{
	"name": "@proseql/ai",
	"version": "1.0.0",
	"description": "AI tool definitions and executor for ProseQL databases",
	"type": "module",
	"scripts": {
		"build": "bun run tsc --build",
		"clean": "rm -rf dist *.tsbuildinfo",
		"prepublishOnly": "bun run build && bun test"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/simonwjackson/proseql.git",
		"directory": "packages/ai"
	},
	"keywords": [
		"database",
		"typescript",
		"effect",
		"ai",
		"tools",
		"llm",
		"plain-text",
		"type-safe"
	],
	"engines": {
		"node": ">=18"
	},
	"sideEffects": false,
	"dependencies": {
		"@proseql/effect": "workspace:1.0.0"
	},
	"peerDependencies": {
		"effect": "4.0.0-beta.103"
	},
	"publishConfig": {
		"access": "public"
	},
	"author": "Simon W. Jackson"
}
